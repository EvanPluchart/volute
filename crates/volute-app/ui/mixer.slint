// The mixer's data and its views, shared by the flyout and the main window. Rust patches the
// models of the `Mixer` global; the views only read them and report what the hand does.

import { Theme } from "theme.slint";
import { AppIcon, Fader, GlyphButton, MicGlyph, SpeakerGlyph } from "controls.slint";

export struct AppRow {
    key: string,
    name: string,
    // The name's first letter, for apps without an icon.
    initial: string,
    system: bool,
    // Slider position, 0 to 1.
    volume: float,
    muted: bool,
    playing: bool,
    // Index into Mixer.icons, or -1.
    icon: int,
}

export struct DeviceRow {
    id: string,
    name: string,
    output: bool,
    // The endpoint scalar, 0 to 1.
    volume: float,
    muted: bool,
    default: bool,
}

export global Mixer {
    in property <[AppRow]> rows;
    in property <[float]> levels;
    in property <[image]> icons;
    in property <[DeviceRow]> outputs;
    in property <[DeviceRow]> inputs;
    in-out property <DeviceRow> master;
    in property <bool> has-master;
    in property <float> master-level;
    in property <DeviceRow> mic;
    in property <bool> has-mic;
    in property <float> mic-level;
    // An error to show, empty when all is well.
    in property <string> error;
    // A command that failed, shown for a moment; empty when there is none.
    in property <string> notice;
    // The first rows have arrived (until then, "no app" would be a lie).
    in property <bool> loaded;

    callback volume-changed(string, float);
    callback volume-released(string, float);
    callback mute-toggled(string, bool);
    callback device-volume-changed(string, float);
    callback device-volume-released(string, float);
    callback device-mute-toggled(string, bool);
    callback default-picked(string);
    callback open-main();
}

// A figure from 0 to 100, right-aligned.
component Figure inherits Text {
    in property <float> value;
    text: Math.round(self.value * 100);
    horizontal-alignment: right;
    vertical-alignment: center;
    width: 40px;
    font-size: Theme.font-figure;
    font-weight: 600;
}

// The master output on the violet band: its name (a click lists the outputs to switch to), a
// mute button, its fader and figure.
export component MasterBand inherits Rectangle {
    property <bool> picking;
    background: Theme.band;

    VerticalLayout {
        padding-left: Theme.space-4;
        padding-right: Theme.space-4;
        padding-top: Theme.space-3;
        padding-bottom: Theme.space-3;
        spacing: Theme.space-2;

        Rectangle {
            height: 28px;
            border-radius: Theme.radius-control;
            background: pick.has-hover ? Theme.band-hover : transparent;
            HorizontalLayout {
                padding-left: Theme.space-1;
                padding-right: Theme.space-1;
                spacing: Theme.space-2;
                Text {
                    text: Mixer.has-master ? Mixer.master.name : @tr("No output");
                    color: Theme.band-text;
                    font-weight: 600;
                    overflow: elide;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Path {
                    width: 14px;
                    height: 14px;
                    y: (parent.height - self.height) / 2;
                    viewbox-width: 14;
                    viewbox-height: 14;
                    commands: root.picking ? "M 3 9 L 7 5 L 11 9" : "M 3 5 L 7 9 L 11 5";
                    stroke: Theme.band-text;
                    stroke-width: 1.8px;
                }
            }
            pick := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.picking = !root.picking; }
            }
        }

        if !root.picking: HorizontalLayout {
            spacing: Theme.space-2;
            GlyphButton {
                hover-color: Theme.band-hover;
                clicked => { Mixer.device-mute-toggled(Mixer.master.id, !Mixer.master.muted); }
                SpeakerGlyph {
                    color: Theme.band-text;
                    muted: Mixer.master.muted;
                }
            }
            Fader {
                y: 4px;
                value <=> Mixer.master.volume;
                level: Mixer.master-level;
                muted: Mixer.master.muted;
                fill-color: Theme.cream;
                track-color: Theme.band-track;
                level-color: Theme.amber;
                thumb-color: Theme.cream;
                muted-color: Theme.band-muted;
                changed(v) => { Mixer.device-volume-changed(Mixer.master.id, v); }
                released(v) => { Mixer.device-volume-released(Mixer.master.id, v); }
            }
            Figure {
                value: Mixer.master.volume;
                color: Theme.band-text;
            }
        }

        if root.picking: VerticalLayout {
            for device in Mixer.outputs: Rectangle {
                height: 34px;
                border-radius: Theme.radius-control;
                background: line.has-hover ? Theme.band-hover : transparent;
                HorizontalLayout {
                    padding-left: Theme.space-2;
                    spacing: Theme.space-3;
                    Rectangle {
                        width: 10px;
                        height: 10px;
                        y: (parent.height - self.height) / 2;
                        border-radius: 5px;
                        border-width: 2px;
                        border-color: Theme.band-text;
                        background: device.default ? Theme.amber : transparent;
                    }
                    Text {
                        text: device.name;
                        color: Theme.band-text;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                }
                line := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        Mixer.default-picked(device.id);
                        root.picking = false;
                    }
                }
            }
        }
    }
}

// One app: its icon (a click mutes it), its name, its fader with the live level, its figure.
export component AppLine inherits Rectangle {
    in-out property <AppRow> app;
    in property <float> level;
    height: 54px;

    HorizontalLayout {
        padding-left: Theme.space-3;
        padding-right: Theme.space-4;
        spacing: Theme.space-2;
        AppIcon {
            y: (parent.height - self.height) / 2;
            icon: root.app.icon >= 0 ? Mixer.icons[root.app.icon] : @image-url("");
            has-icon: root.app.icon >= 0;
            initial: root.app.initial;
            system: root.app.system;
            muted: root.app.muted;
            toggled => { Mixer.mute-toggled(root.app.key, !root.app.muted); }
        }
        VerticalLayout {
            alignment: center;
            spacing: 0px;
            Text {
                text: root.app.system ? @tr("System sounds") : root.app.name;
                color: root.app.playing ? Theme.text : Theme.text-muted;
                font-size: Theme.font-caption;
                overflow: elide;
            }
            Fader {
                value <=> root.app.volume;
                level: root.level;
                muted: root.app.muted;
                changed(v) => { Mixer.volume-changed(root.app.key, v); }
                released(v) => { Mixer.volume-released(root.app.key, v); }
            }
        }
        Figure {
            value: root.app.volume;
            color: root.app.muted ? Theme.text-muted : Theme.text;
            font-size: 15px;
        }
    }
}

// The microphone in a footer: mute, a level meter and its name; and the way to the main window.
export component Footer inherits Rectangle {
    in property <bool> show-open: true;
    height: 48px;
    background: Theme.surface;

    Rectangle {
        y: 0;
        height: 1px;
        background: Theme.border;
    }

    HorizontalLayout {
        padding-left: Theme.space-3;
        padding-right: Theme.space-3;
        spacing: Theme.space-2;
        if Mixer.has-mic: GlyphButton {
            y: (parent.height - self.height) / 2;
            clicked => { Mixer.device-mute-toggled(Mixer.mic.id, !Mixer.mic.muted); }
            MicGlyph {
                color: Mixer.mic.muted ? Theme.danger : Theme.text-muted;
                muted: Mixer.mic.muted;
            }
        }
        if Mixer.has-mic: VerticalLayout {
            alignment: center;
            spacing: 3px;
            horizontal-stretch: 1;
            Text {
                text: Mixer.mic.name;
                color: Theme.text-muted;
                font-size: Theme.font-caption;
                overflow: elide;
            }
            Rectangle {
                height: 4px;
                border-radius: 2px;
                background: Theme.track;
                clip: true;
                Rectangle {
                    x: 0;
                    width: parent.width * (Mixer.mic.muted ? 0 : Math.min(Mixer.mic-level, 1));
                    background: Theme.level;
                }
            }
        }
        if !Mixer.has-mic: Rectangle {
            horizontal-stretch: 1;
        }
        if root.show-open: Rectangle {
            width: open-text.preferred-width + 2 * Theme.space-3;
            height: 30px;
            y: (parent.height - self.height) / 2;
            border-radius: Theme.radius-control;
            background: open.has-hover ? Theme.raised : transparent;
            open-text := Text {
                text: @tr("Open Volute");
                color: Theme.text-muted;
                font-size: Theme.font-caption;
            }
            open := TouchArea {
                mouse-cursor: pointer;
                clicked => { Mixer.open-main(); }
            }
        }
    }
}

// The apps, one line each, scrolling past `max-height`.
export component AppList inherits Rectangle {
    in property <length> limit: 420px;
    property <length> content: Math.max(Mixer.rows.length, 1) * 54px + 12px;
    height: Math.min(self.content, self.limit);
    background: Theme.surface;

    if Mixer.error != "": Text {
        x: Theme.space-4;
        width: parent.width - 2 * Theme.space-4;
        text: @tr("Audio is unavailable: {}", Mixer.error);
        color: Theme.danger;
        wrap: word-wrap;
        vertical-alignment: center;
    }

    if Mixer.error == "" && Mixer.loaded && Mixer.rows.length == 0: Text {
        text: @tr("No app is playing sound.");
        color: Theme.text-muted;
    }

    if Mixer.notice != "": Rectangle {
        x: Theme.space-3;
        y: parent.height - self.height - Theme.space-2;
        width: parent.width - 2 * Theme.space-3;
        height: notice-text.preferred-height + 2 * Theme.space-2;
        z: 1;
        border-radius: Theme.radius-control;
        background: Theme.raised;
        border-width: 1px;
        border-color: Theme.danger;
        notice-text := Text {
            x: Theme.space-3;
            width: parent.width - 2 * Theme.space-3;
            text: Mixer.notice;
            color: Theme.text;
            font-size: Theme.font-caption;
            wrap: word-wrap;
            vertical-alignment: center;
        }
    }

    Flickable {
        content-height: root.content;
        VerticalLayout {
            padding-top: 6px;
            padding-bottom: 6px;
            alignment: start;
            for row[i] in Mixer.rows: AppLine {
                app <=> row;
                level: Mixer.levels[i];
            }
        }
    }
}

// Outputs and inputs, for the main window's Devices view.
export component DevicesPanel inherits VerticalLayout {
    padding: Theme.space-4;
    spacing: Theme.space-2;

    Text {
        text: @tr("Outputs");
        color: Theme.text-muted;
        font-size: Theme.font-caption;
        font-weight: 600;
    }
    for device in Mixer.outputs: Rectangle {
        height: 64px;
        border-radius: Theme.radius-card;
        background: Theme.surface;
        border-width: 1px;
        border-color: device.default ? Theme.fill : Theme.border;
        HorizontalLayout {
            padding-left: Theme.space-3;
            padding-right: Theme.space-4;
            spacing: Theme.space-2;
            GlyphButton {
                y: (parent.height - self.height) / 2;
                clicked => { Mixer.device-mute-toggled(device.id, !device.muted); }
                SpeakerGlyph {
                    color: device.muted ? Theme.danger : Theme.text;
                    muted: device.muted;
                }
            }
            VerticalLayout {
                alignment: center;
                HorizontalLayout {
                    spacing: Theme.space-2;
                    Text {
                        text: device.name;
                        color: Theme.text;
                        font-weight: device.default ? 600 : 400;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: device.default ? @tr("Default") : @tr("Make default");
                        color: device.default ? Theme.fill : Theme.text-muted;
                        font-size: Theme.font-caption;
                        TouchArea {
                            mouse-cursor: device.default ? default : pointer;
                            clicked => {
                                if (!device.default) {
                                    Mixer.default-picked(device.id);
                                }
                            }
                        }
                    }
                }
                Fader {
                    value <=> device.volume;
                    muted: device.muted;
                    level: device.default ? Mixer.master-level : 0;
                    changed(v) => { Mixer.device-volume-changed(device.id, v); }
                    released(v) => { Mixer.device-volume-released(device.id, v); }
                }
            }
            Figure {
                value: device.volume;
                color: Theme.text;
                font-size: 15px;
            }
        }
    }

    Text {
        text: @tr("Inputs");
        color: Theme.text-muted;
        font-size: Theme.font-caption;
        font-weight: 600;
    }
    for device in Mixer.inputs: Rectangle {
        height: 52px;
        border-radius: Theme.radius-card;
        background: Theme.surface;
        border-width: 1px;
        border-color: Theme.border;
        HorizontalLayout {
            padding-left: Theme.space-3;
            padding-right: Theme.space-4;
            spacing: Theme.space-2;
            GlyphButton {
                y: (parent.height - self.height) / 2;
                clicked => { Mixer.device-mute-toggled(device.id, !device.muted); }
                MicGlyph {
                    color: device.muted ? Theme.danger : Theme.text;
                    muted: device.muted;
                }
            }
            VerticalLayout {
                alignment: center;
                spacing: 4px;
                Text {
                    text: device.name;
                    color: Theme.text;
                    overflow: elide;
                }
                Rectangle {
                    height: 4px;
                    border-radius: 2px;
                    background: Theme.track;
                    clip: true;
                    Rectangle {
                        x: 0;
                        width: parent.width * (device.default && !device.muted ? Math.min(Mixer.mic-level, 1) : 0);
                        background: Theme.level;
                    }
                }
            }
        }
    }
    Rectangle { }
}
