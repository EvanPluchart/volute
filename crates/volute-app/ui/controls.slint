// Volute's own controls (docs/BRAND.md: instruments, not forms). Flat shapes only: no shadows,
// no transparency effects, cheap for the software renderer.

import { Theme } from "theme.slint";

// A fader: the track fills up to the value, the live level runs inside it in the accent, and a
// round thumb follows the hand. Click or drag anywhere on it, scroll, or use the arrow keys.
export component Fader inherits FocusScope {
    in-out property <float> value;
    in property <float> level;
    in property <bool> muted;
    in property <color> fill-color: Theme.fill;
    in property <color> track-color: Theme.track;
    in property <color> level-color: Theme.level;
    in property <color> thumb-color: Theme.thumb;
    in property <color> muted-color: Theme.text-muted;
    callback changed(float);
    callback released(float);

    property <length> knob: 16px;
    property <length> span: root.width - root.knob;

    height: 24px;
    min-width: 80px;
    horizontal-stretch: 1;
    accessible-role: slider;
    accessible-value: Math.round(root.value * 100);
    accessible-value-minimum: 0;
    accessible-value-maximum: 100;

    function set(v: float) {
        root.value = Math.clamp(v, 0, 1);
        root.changed(root.value);
    }

    key-pressed(event) => {
        if (event.text == Key.RightArrow || event.text == Key.UpArrow) {
            root.set(root.value + 0.02);
        } else if (event.text == Key.LeftArrow || event.text == Key.DownArrow) {
            root.set(root.value - 0.02);
        } else if (event.text == Key.PageUp) {
            root.set(root.value + 0.1);
        } else if (event.text == Key.PageDown) {
            root.set(root.value - 0.1);
        } else if (event.text == Key.Home) {
            root.set(0);
        } else if (event.text == Key.End) {
            root.set(1);
        } else {
            return reject;
        }
        root.released(root.value);
        accept
    }

    Rectangle {
        x: root.knob / 2;
        y: (root.height - self.height) / 2;
        width: root.span;
        height: 6px;
        border-radius: 3px;
        background: root.track-color;
        clip: true;

        Rectangle {
            x: 0;
            width: parent.width * root.value;
            background: root.muted ? root.muted-color : root.fill-color;
        }

        Rectangle {
            x: 0;
            width: parent.width * Math.min(root.level, 1);
            background: root.level-color;
            visible: !root.muted && root.level > 0.004;
        }
    }

    Rectangle {
        x: root.span * root.value;
        y: (root.height - self.height) / 2;
        width: root.knob;
        height: root.knob;
        border-radius: root.knob / 2;
        background: root.thumb-color;
        border-width: 2px;
        border-color: root.muted ? root.muted-color : root.fill-color;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                root.focus();
                root.set((self.mouse-x - root.knob / 2) / root.span);
            } else if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left) {
                root.released(root.value);
            }
        }
        moved => {
            if (self.pressed) {
                root.set((self.mouse-x - root.knob / 2) / root.span);
            }
        }
        scroll-event(event) => {
            if (event.delta-y == 0) {
                return reject;
            }
            root.set(root.value + (event.delta-y > 0 ? 0.02 : -0.02));
            root.released(root.value);
            accept
        }
    }
}

// A speaker: the sound waves when on, a cross when muted.
export component SpeakerGlyph inherits Path {
    in property <bool> muted;
    in property <color> color;
    width: 20px;
    height: 20px;
    viewbox-width: 24;
    viewbox-height: 24;
    stroke: self.color;
    stroke-width: 1.8px;
    fill: transparent;
    commands: self.muted
        ? "M 4 9.5 L 7.5 9.5 L 12 5.5 L 12 18.5 L 7.5 14.5 L 4 14.5 Z M 16 9.5 L 21 14.5 M 21 9.5 L 16 14.5"
        : "M 4 9.5 L 7.5 9.5 L 12 5.5 L 12 18.5 L 7.5 14.5 L 4 14.5 Z M 15.5 9 A 4 4 0 0 1 15.5 15 M 18 6.5 A 7.5 7.5 0 0 1 18 17.5";
}

// A microphone, crossed out when muted.
export component MicGlyph inherits Path {
    in property <bool> muted;
    in property <color> color;
    width: 20px;
    height: 20px;
    viewbox-width: 24;
    viewbox-height: 24;
    stroke: self.color;
    stroke-width: 1.8px;
    fill: transparent;
    commands: self.muted
        ? "M 9 5 A 3 3 0 0 1 15 5 L 15 11 A 3 3 0 0 1 9 11 Z M 6 11 A 6 6 0 0 0 18 11 M 12 17 L 12 20.5 M 4 4 L 20 20"
        : "M 9 5 A 3 3 0 0 1 15 5 L 15 11 A 3 3 0 0 1 9 11 Z M 6 11 A 6 6 0 0 0 18 11 M 12 17 L 12 20.5";
}

// A round button holding a glyph, for the master and the microphone.
export component GlyphButton inherits Rectangle {
    in property <color> hover-color: Theme.raised;
    callback clicked();
    width: 32px;
    height: 32px;
    border-radius: self.width / 2;
    background: touch.has-hover ? root.hover-color : transparent;
    accessible-role: button;
    accessible-action-default => { root.clicked(); }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    @children
}

// An app's icon, which mutes the app when clicked: faded and struck through while muted. An app
// without an icon gets its initial on a small violet tile.
export component AppIcon inherits Rectangle {
    in property <image> icon;
    in property <bool> has-icon;
    in property <string> initial;
    in property <bool> system;
    in property <bool> muted;
    callback toggled();

    width: 36px;
    height: 36px;
    border-radius: Theme.radius-control;
    background: touch.has-hover ? Theme.raised : transparent;
    accessible-role: button;
    accessible-checked: root.muted;
    accessible-action-default => { root.toggled(); }

    if root.has-icon: Image {
        source: root.icon;
        width: 24px;
        height: 24px;
        opacity: root.muted ? 0.35 : 1;
    }

    if !root.has-icon && !root.system: Rectangle {
        width: 24px;
        height: 24px;
        border-radius: 6px;
        background: Theme.violet;
        opacity: root.muted ? 0.35 : 1;
        Text {
            text: root.initial;
            color: Theme.cream;
            font-size: 13px;
            font-weight: 700;
        }
    }

    if !root.has-icon && root.system: SpeakerGlyph {
        color: Theme.text-muted;
        muted: false;
        opacity: root.muted ? 0.35 : 1;
    }

    if root.muted: Path {
        width: 26px;
        height: 26px;
        viewbox-width: 26;
        viewbox-height: 26;
        commands: "M 4 22 L 22 4";
        stroke: Theme.danger;
        stroke-width: 2.5px;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggled(); }
    }
}
