// Volute's own controls (docs/BRAND.md: instruments, not forms). Flat shapes only: no shadows,
// no transparency effects, cheap for the software renderer.

import { Theme } from "theme.slint";

// A fader: a neutral track filled up to the value, the live level glowing in amber inside the
// fill, and a light thumb with a ring cut out of the surface. Click or drag anywhere on it,
// scroll, or use the arrow keys.
export component Fader inherits FocusScope {
    in-out property <float> value;
    // The session's peak, 0 to 1, before its volume: shown scaled by the value, so it never
    // runs past the thumb.
    in property <float> level;
    in property <bool> muted;
    in property <length> track: 4px;
    in property <length> knob: 14px;
    in property <color> fill-color: Theme.fill;
    in property <color> ring-color: Theme.thumb-ring;
    callback changed(float);
    callback released(float);

    property <length> span: root.width - root.knob;
    property <bool> active: touch.has-hover || touch.pressed || root.has-focus;

    height: 28px;
    min-width: 80px;
    horizontal-stretch: 1;
    accessible-role: slider;
    accessible-value: Math.round(root.value * 100);
    accessible-value-minimum: 0;
    accessible-value-maximum: 100;
    accessible-value-step: 2;

    function set(v: float) {
        root.value = Math.clamp(v, 0, 1);
        root.changed(root.value);
    }

    key-pressed(event) => {
        if (event.text == Key.RightArrow || event.text == Key.UpArrow) {
            root.set(root.value + 0.02);
        } else if (event.text == Key.LeftArrow || event.text == Key.DownArrow) {
            root.set(root.value - 0.02);
        } else if (event.text == Key.PageUp) {
            root.set(root.value + 0.1);
        } else if (event.text == Key.PageDown) {
            root.set(root.value - 0.1);
        } else if (event.text == Key.Home) {
            root.set(0);
        } else if (event.text == Key.End) {
            root.set(1);
        } else {
            return reject;
        }
        root.released(root.value);
        accept
    }

    // The track, its fill and the level inside it.
    Rectangle {
        x: root.knob / 2;
        y: (root.height - self.height) / 2;
        width: root.span;
        height: root.track;
        border-radius: root.track / 2;
        background: Theme.track;
        clip: true;

        Rectangle {
            x: 0;
            width: parent.width * root.value;
            background: root.muted ? Theme.fill-muted : root.active ? Theme.fill-strong : root.fill-color;
        }

        Rectangle {
            x: 0;
            width: parent.width * root.value * Math.min(root.level, 1);
            background: Theme.level;
            visible: !root.muted && root.level > 0.004;
        }
    }

    // The thumb: a light disc, ringed in the surface colour so it sits on the track.
    Rectangle {
        x: root.span * root.value - 2px;
        y: (root.height - self.height) / 2;
        width: root.knob + 4px;
        height: self.width;
        border-radius: self.width / 2;
        background: root.ring-color;

        Rectangle {
            x: 2px;
            y: 2px;
            width: root.knob;
            height: root.knob;
            border-radius: root.knob / 2;
            background: root.muted ? Theme.fill-muted : Theme.thumb;
            border-width: Theme.dark ? 0px : 1px;
            border-color: root.has-focus ? Theme.accent : Theme.thumb-ring;
        }
    }

    // Keyboard focus: a violet ring around the thumb.
    if root.has-focus: Rectangle {
        x: root.span * root.value - 4px;
        y: (root.height - self.height) / 2;
        width: root.knob + 8px;
        height: self.width;
        border-radius: self.width / 2;
        border-width: 2px;
        border-color: Theme.accent;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                root.focus();
                root.set((self.mouse-x - root.knob / 2) / root.span);
            } else if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left) {
                root.released(root.value);
            }
        }
        moved => {
            if (self.pressed) {
                root.set((self.mouse-x - root.knob / 2) / root.span);
            }
        }
        scroll-event(event) => {
            if (event.delta-y == 0) {
                return reject;
            }
            root.set(root.value + (event.delta-y > 0 ? 0.02 : -0.02));
            root.released(root.value);
            accept
        }
    }
}

// A level meter on its own (the microphone): a thin track, amber up to the level.
export component Meter inherits Rectangle {
    in property <float> level;
    in property <bool> muted;
    height: 4px;
    border-radius: self.height / 2;
    background: Theme.track;
    clip: true;
    Rectangle {
        x: 0;
        width: parent.width * (root.muted ? 0 : Math.min(root.level, 1));
        background: Theme.level;
    }
}

// A speaker: the sound waves when on, a cross when muted.
export component SpeakerGlyph inherits Path {
    in property <bool> muted;
    in property <color> color;
    width: 20px;
    height: 20px;
    viewbox-width: 24;
    viewbox-height: 24;
    stroke: self.color;
    stroke-width: 1.8px;
    fill: transparent;
    commands: self.muted
        ? "M 4 9.5 L 7.5 9.5 L 12 5.5 L 12 18.5 L 7.5 14.5 L 4 14.5 Z M 16 9.5 L 21 14.5 M 21 9.5 L 16 14.5"
        : "M 4 9.5 L 7.5 9.5 L 12 5.5 L 12 18.5 L 7.5 14.5 L 4 14.5 Z M 15.5 9 A 4 4 0 0 1 15.5 15 M 18 6.5 A 7.5 7.5 0 0 1 18 17.5";
}

// A microphone, crossed out when muted.
export component MicGlyph inherits Path {
    in property <bool> muted;
    in property <color> color;
    width: 20px;
    height: 20px;
    viewbox-width: 24;
    viewbox-height: 24;
    stroke: self.color;
    stroke-width: 1.8px;
    fill: transparent;
    commands: self.muted
        ? "M 9 5 A 3 3 0 0 1 15 5 L 15 11 A 3 3 0 0 1 9 11 Z M 6 11 A 6 6 0 0 0 18 11 M 12 17 L 12 20.5 M 4 4 L 20 20"
        : "M 9 5 A 3 3 0 0 1 15 5 L 15 11 A 3 3 0 0 1 9 11 Z M 6 11 A 6 6 0 0 0 18 11 M 12 17 L 12 20.5";
}

// Line glyphs for the rail and buttons, drawn on a 24 grid so no font needs the symbol.
export component Glyph inherits Path {
    // "mixer", "devices", "settings", "about", "window", "chevron-down", "chevron-up", "check",
    // "arrow-up-right"
    in property <string> name;
    in property <color> color;
    width: 20px;
    height: 20px;
    viewbox-width: 24;
    viewbox-height: 24;
    stroke: self.color;
    stroke-width: 1.8px;
    fill: transparent;
    commands: self.name == "mixer"
        ? "M 6 4 L 6 20 M 12 4 L 12 20 M 18 4 L 18 20 M 3.5 14 L 8.5 14 M 9.5 8 L 14.5 8 M 15.5 16 L 20.5 16"
        : self.name == "devices"
        ? "M 7 3.5 L 17 3.5 A 2 2 0 0 1 19 5.5 L 19 18.5 A 2 2 0 0 1 17 20.5 L 7 20.5 A 2 2 0 0 1 5 18.5 L 5 5.5 A 2 2 0 0 1 7 3.5 Z M 12 10.5 A 4 4 0 1 1 12 18.5 A 4 4 0 1 1 12 10.5 Z M 12 6.5 L 12 6.6"
        : self.name == "settings"
        ? "M 3.5 8 L 20.5 8 M 3.5 16 L 20.5 16 M 9 5.5 A 2.5 2.5 0 1 1 9 10.5 A 2.5 2.5 0 1 1 9 5.5 Z M 15 13.5 A 2.5 2.5 0 1 1 15 18.5 A 2.5 2.5 0 1 1 15 13.5 Z"
        : self.name == "about"
        ? "M 12 3.5 A 8.5 8.5 0 1 1 12 20.5 A 8.5 8.5 0 1 1 12 3.5 Z M 12 11 L 12 16.5 M 12 7.5 L 12 7.6"
        : self.name == "window"
        ? "M 5 4.5 L 19 4.5 A 1.5 1.5 0 0 1 20.5 6 L 20.5 18 A 1.5 1.5 0 0 1 19 19.5 L 5 19.5 A 1.5 1.5 0 0 1 3.5 18 L 3.5 6 A 1.5 1.5 0 0 1 5 4.5 Z M 3.5 9 L 20.5 9"
        : self.name == "chevron-down"
        ? "M 7 10 L 12 15 L 17 10"
        : self.name == "chevron-up"
        ? "M 7 14 L 12 9 L 17 14"
        : self.name == "check"
        ? "M 5.5 12.5 L 10 17 L 18.5 7.5"
        : self.name == "arrow-up-right"
        ? "M 8 16 L 16 8 M 9.5 8 L 16 8 L 16 14.5"
        : "";
}

// Gives a clickable control the keyboard: it takes focus with Tab, Space or Enter activates
// it, and a violet ring shows where the focus is. Placed under the control's TouchArea.
export component Activator inherits FocusScope {
    in property <length> radius;
    callback activated();
    key-pressed(event) => {
        if (event.text == Key.Space || event.text == Key.Return) {
            root.activated();
            return accept;
        }
        reject
    }
    if root.has-focus: Rectangle {
        border-width: 2px;
        border-color: Theme.accent;
        border-radius: root.radius;
    }
}

// A round button holding a glyph, for the master and the microphone.
export component GlyphButton inherits Rectangle {
    in property <string> label;
    callback clicked();
    width: 32px;
    height: 32px;
    border-radius: self.width / 2;
    background: touch.has-hover ? Theme.raised : transparent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }

    Activator {
        radius: root.width / 2;
        activated => { root.clicked(); }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    @children
}

// A text button: "primary" on violet, otherwise quiet with a hairline.
export component Button inherits Rectangle {
    in property <string> text;
    in property <bool> primary;
    in property <bool> enabled: true;
    callback clicked();
    height: 30px;
    min-width: label.preferred-width + 2 * Theme.space-3;
    horizontal-stretch: 0;
    border-radius: Theme.radius-control;
    background: !root.enabled ? Theme.surface
        : root.primary ? (touch.has-hover ? Theme.accent.darker(0.15) : Theme.accent)
        : (touch.has-hover ? Theme.raised : Theme.surface);
    border-width: root.primary ? 0px : 1px;
    border-color: Theme.line;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }

    label := Text {
        text: root.text;
        color: !root.enabled ? Theme.text-faint : root.primary ? Theme.on-accent : Theme.text;
        font-size: Theme.font-body;
        font-weight: Theme.weight-medium;
    }
    Activator {
        radius: Theme.radius-control;
        activated => { if (root.enabled) { root.clicked(); } }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

// A link in violet, underlined on hover.
export component Link inherits Text {
    callback clicked();
    color: Theme.accent-text;
    font-size: Theme.font-body;
    font-weight: Theme.weight-medium;
    accessible-role: button;
    accessible-action-default => { root.clicked(); }
    Activator {
        radius: 4px;
        activated => { root.clicked(); }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.accent-text;
        visible: touch.has-hover;
    }
}

// An on/off switch.
export component Switch inherits Rectangle {
    in-out property <bool> checked;
    in property <bool> enabled: true;
    in property <string> label;
    callback toggled(bool);
    width: 40px;
    height: 22px;
    border-radius: self.height / 2;
    background: root.checked ? Theme.accent : Theme.track;
    opacity: root.enabled ? 1 : 0.45;
    accessible-role: switch;
    accessible-label: root.label;
    accessible-checked: root.checked;
    accessible-enabled: root.enabled;
    accessible-action-default => { root.flip(); }

    function flip() {
        if (root.enabled) {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }

    Rectangle {
        x: root.checked ? parent.width - self.width - 3px : 3px;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: root.checked ? Theme.on-accent : Theme.text-muted;
    }
    Activator {
        radius: root.height / 2;
        activated => { root.flip(); }
    }
    TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.flip(); }
    }
}

// One choice of a segmented control.
export component Segment inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    callback clicked();
    height: 26px;
    horizontal-stretch: 1;
    min-width: label.preferred-width + 2 * Theme.space-3;
    border-radius: 6px;
    background: root.selected ? Theme.background : touch.has-hover ? Theme.hover : transparent;
    border-width: root.selected && !Theme.dark ? 1px : 0px;
    border-color: Theme.line;
    accessible-role: button;
    accessible-label: root.text;
    accessible-checked: root.selected;
    accessible-action-default => { root.clicked(); }
    label := Text {
        text: root.text;
        color: root.selected ? Theme.text : Theme.text-muted;
        font-size: Theme.font-body;
        font-weight: root.selected ? Theme.weight-strong : Theme.weight-medium;
    }
    Activator {
        radius: 6px;
        activated => { root.clicked(); }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// An app's icon, which mutes the app when clicked: faded and struck through while muted. An app
// without an icon gets its initial on a quiet tile; system sounds get the speaker.
export component AppIcon inherits Rectangle {
    in property <image> icon;
    in property <bool> has-icon;
    in property <string> initial;
    in property <bool> system;
    in property <bool> muted;
    in property <string> name;
    callback toggled();

    width: 36px;
    height: 36px;
    border-radius: Theme.radius-control;
    background: touch.has-hover ? Theme.raised : transparent;
    accessible-role: button;
    accessible-label: root.muted ? @tr("Unmute {}", root.name) : @tr("Mute {}", root.name);
    accessible-checked: root.muted;
    accessible-action-default => { root.toggled(); }

    if root.has-icon: Image {
        source: root.icon;
        width: 24px;
        height: 24px;
        opacity: root.muted ? 0.35 : 1;
    }

    if !root.has-icon && !root.system: Rectangle {
        width: 24px;
        height: 24px;
        border-radius: 7px;
        background: Theme.raised;
        border-width: 1px;
        border-color: Theme.line;
        opacity: root.muted ? 0.45 : 1;
        Text {
            text: root.initial;
            color: Theme.text-muted;
            font-size: 12px;
            font-weight: Theme.weight-strong;
        }
    }

    if !root.has-icon && root.system: SpeakerGlyph {
        color: Theme.text-muted;
        muted: false;
        opacity: root.muted ? 0.45 : 1;
    }

    if root.muted: Path {
        width: 26px;
        height: 26px;
        viewbox-width: 26;
        viewbox-height: 26;
        commands: "M 4 22 L 22 4";
        stroke: Theme.danger;
        stroke-width: 2.5px;
    }

    Activator {
        radius: Theme.radius-control;
        activated => { root.toggled(); }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggled(); }
    }
}
