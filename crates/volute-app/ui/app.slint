// Volute's windows: the flyout opened from the tray, the main window, and About. The mixer's
// data and views are in mixer.slint, the controls in controls.slint, the tokens in theme.slint.

import { AboutSlint, Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { AppList, DevicesPanel, Footer, MasterBand, Mixer } from "mixer.slint";

export { Mixer, AppRow, DeviceRow } from "mixer.slint";

// The tray menu's labels, translated here like every other string.
export global TrayText {
    public pure function open() -> string {
        return @tr("Open Volute");
    }
    public pure function quit() -> string {
        return @tr("Quit");
    }
    public pure function tooltip(device: string, volume: int, muted: bool) -> string {
        return muted ? @tr("{}: muted", device) : @tr("{}: {}%", device, volume);
    }
}

// The mixer at the tray: the master on its band, one line per app, the microphone. It closes
// when it loses focus, and on Escape.
export component Flyout inherits Window {
    callback dismiss();

    // 0 follows the system, 1 dark, 2 light.
    public function set-scheme(scheme: int) {
        Palette.color-scheme = scheme == 1 ? ColorScheme.dark : scheme == 2 ? ColorScheme.light : ColorScheme.unknown;
    }

    title: "Volute";
    icon: @image-url("../../../assets/brand/png/volute-app-icon-64.png");
    no-frame: true;
    always-on-top: true;
    width: 360px;
    height: layout.preferred-height;
    background: Theme.surface;
    default-font-size: Theme.font-body;

    FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.dismiss();
                return accept;
            }
            reject
        }
    }

    layout := VerticalLayout {
        MasterBand { }
        AppList {
            limit: 432px;
        }
        Footer { }
    }

    Rectangle {
        border-width: 1px;
        border-color: Theme.border;
    }
}

export component AboutWindow inherits Window {
    in property <string> version;

    // 0 follows the system, 1 dark, 2 light.
    public function set-scheme(scheme: int) {
        Palette.color-scheme = scheme == 1 ? ColorScheme.dark : scheme == 2 ? ColorScheme.light : ColorScheme.unknown;
    }

    title: @tr("About Volute");
    icon: @image-url("../../../assets/brand/png/volute-app-icon-64.png");
    background: Theme.background;
    default-font-size: Theme.font-body;

    VerticalLayout {
        padding: Theme.space-6;
        spacing: Theme.space-3;
        Image {
            source: Theme.dark
                ? @image-url("../../../assets/brand/png/volute-horizontal-reversed.png")
                : @image-url("../../../assets/brand/png/volute-horizontal.png");
            height: 56px;
            image-fit: contain;
            horizontal-alignment: left;
        }
        Text {
            text: @tr("Version {}", root.version);
            color: Theme.text-muted;
        }
        Text {
            text: @tr("A volume mixer for Windows.");
            color: Theme.text;
            wrap: word-wrap;
        }
        AboutSlint { }
    }
}

component Tab inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    callback clicked();
    height: 32px;
    width: tab-text.preferred-width + 2 * Theme.space-4;
    border-radius: 16px;
    background: root.selected ? Theme.fill : touch.has-hover ? Theme.raised : transparent;
    accessible-role: tab;
    accessible-label: root.label;
    tab-text := Text {
        text: root.label;
        color: root.selected ? Theme.cream : Theme.text;
        font-weight: 600;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// The main window: the mixer, and every device.
export component AppWindow inherits Window {
    in-out property <int> tab;
    callback show-about();

    // 0 follows the system, 1 dark, 2 light.
    public function set-scheme(scheme: int) {
        Palette.color-scheme = scheme == 1 ? ColorScheme.dark : scheme == 2 ? ColorScheme.light : ColorScheme.unknown;
    }

    title: "Volute";
    icon: @image-url("../../../assets/brand/png/volute-app-icon-64.png");
    preferred-width: 460px;
    preferred-height: 620px;
    min-width: 360px;
    min-height: 320px;
    background: Theme.background;
    default-font-size: Theme.font-body;

    VerticalLayout {
        HorizontalLayout {
            padding: Theme.space-3;
            spacing: Theme.space-2;
            Tab {
                label: @tr("Mixer");
                selected: root.tab == 0;
                clicked => { root.tab = 0; }
            }
            Tab {
                label: @tr("Devices");
                selected: root.tab == 1;
                clicked => { root.tab = 1; }
            }
            Rectangle { }
            Tab {
                label: @tr("About");
                selected: false;
                clicked => { root.show-about(); }
            }
        }

        if root.tab == 0: VerticalLayout {
            MasterBand { }
            // The list fills the window and scrolls: no height of its own to cap the window.
            Rectangle {
                vertical-stretch: 1;
                AppList {
                    width: parent.width;
                    height: parent.height;
                }
            }
            Footer {
                show-open: false;
            }
        }

        if root.tab == 1: Flickable {
            vertical-stretch: 1;
            DevicesPanel { }
        }
    }
}
